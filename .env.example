# ─────────────────────────────────────────────────────────
# MERIHAANAA — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────────────────────

# ── SUPABASE ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── CLOUDFLARE R2 ────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=merihaanaa-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.merihaanaa.com

# ── CLOUDFLARE STREAM ────────────────────────────────────
CLOUDFLARE_STREAM_TOKEN=your_stream_api_token
CLOUDFLARE_STREAM_CUSTOMER_ID=your_customer_subdomain

# ── RESEND (Email / Newsletter) ───────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hello@merihaanaa.com
RESEND_FROM_NAME=މެރިހާނާ

# ── APP ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=މެރިހާނާ
